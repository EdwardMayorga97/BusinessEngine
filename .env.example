# ============================================================
# BusinessEngine AI OS — Variables de entorno
# Copiar a .env y completar con valores reales
# ============================================================

# SISTEMA
APP_NAME=BusinessEngine
APP_ENV=development
APP_SECRET_KEY=change-this-in-production-use-random-32-chars
APP_PORT=8000

# BASE DE DATOS
DATABASE_URL=postgresql://user:password@localhost:5432/businessengine
DB_USER=user
DB_PASSWORD=password
DB_NAME=businessengine

# CACHE Y QUEUE
REDIS_URL=redis://localhost:6379

# ============================================================
# MODELOS AI — Al menos uno requerido
# El sistema usará el primero disponible como fallback
# ============================================================
ANTHROPIC_API_KEY=          # Claude (Anthropic) — recomendado
OPENAI_API_KEY=             # OpenAI / GPT
GOOGLE_API_KEY=             # Gemini (Google)
OLLAMA_BASE_URL=http://localhost:11434   # Modelos locales — gratis, sin internet

# Modelo por tipo de tarea
DEFAULT_MODEL_FAST=claude-haiku-4-5-20251001    # Tareas simples, barato
DEFAULT_MODEL_SMART=claude-sonnet-4-6           # Razonamiento complejo
DEFAULT_MODEL_LOCAL=ollama/llama3               # Datos sensibles, gratis

# ============================================================
# ALMACENAMIENTO DE ARCHIVOS (MinIO — self-hosted)
# ============================================================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=businessengine
MINIO_SECURE=false

# ============================================================
# VOZ
# ============================================================
WHISPER_MODEL=base          # tiny | base | small | medium | large
TTS_ENGINE=kokoro           # kokoro (local, gratis)

# ============================================================
# SEGURIDAD
# ============================================================
JWT_SECRET=change-this-in-production
JWT_EXPIRATION_HOURS=8
ENCRYPTION_KEY=change-this-in-production

# ============================================================
# INTEGRACIONES EXTERNAS (todas opcionales)
# ============================================================

# Email
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=

# Calendario
GOOGLE_CALENDAR_ID=

# WhatsApp Business
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Pagos
STRIPE_SECRET_KEY=
MERCADOPAGO_TOKEN=
